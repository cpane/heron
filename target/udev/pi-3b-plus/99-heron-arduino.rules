# Arduino motor controller, on a Raspberry Pi 3B+.
#
# The same rule as ../pi-3b/99-heron-arduino.rules, with the 3B+'s port
# numbers; ./99-heron-rplidar.rules explains them. Keep the two in step:
#
#   KERNELS "1-1.1.2"   the Arduino (this file)
#   KERNELS "1-1.3"     the LiDAR
#
# Code must open /dev/arduino, never /dev/ttyUSB*.
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", KERNELS=="1-1.1.2", SYMLINK+="arduino", MODE="0660", GROUP="dialout"
